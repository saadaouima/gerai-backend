# Oracle Container (Docker)
ORACLE_PASSWORD=your_oracle_system_password

# Spring Boot App (Hibernate)
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Keycloak Container (Docker)
KEYCLOAK_ADMIN_USERNAME=your_keycloak_admin_username
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

# Keycloak Admin (Spring Boot)
KC_SERVER_URL=http://localhost:8080
KC_ADMIN_USERNAME=your_keycloak_admin_username
KC_ADMIN_PASSWORD=your_keycloak_admin_password
KC_TARGET_REALM=your_realm_name

# Keycloak OAuth2 Client
KC_CLIENT_ID=your_client_id
KC_CLIENT_SECRET=YOUR_CLIENT_SECRET
KC_ISSUER_URI=http://localhost:8080/realms/your_realm_name
KC_REDIRECT_URI=http://localhost:8081/login/oauth2/code/keycloak

# Mail
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# To get MAIL_PASSWORD:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an app password named "grh-backend"
# 5. Copy the 16-character password here