<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="fiche_employe"
              pageWidth="595" pageHeight="842"
              orientation="Portrait"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20">

    <parameter name="GENERATED_DATE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></defaultValueExpression>
    </parameter>
    <parameter name="EMPLOYE_NOM" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Employé"]]></defaultValueExpression>
    </parameter>
    <parameter name="EMPLOYE_ID" class="java.lang.Long" isForPrompting="false">
        <defaultValueExpression><![CDATA[0L]]></defaultValueExpression>
    </parameter>
    <parameter name="MATRICULE" class="java.lang.String" isForPrompting="false"/>
    <parameter name="DEPARTEMENT" class="java.lang.String" isForPrompting="false"/>
    <parameter name="EMAIL" class="java.lang.String" isForPrompting="false"/>
    <parameter name="DATE_EMBAUCHE" class="java.lang.String" isForPrompting="false"/>

    <field name="TYPE"          class="java.lang.String"/>
    <field name="STATUT"        class="java.lang.String"/>
    <field name="DATE_CREATION" class="java.lang.String"/>
    <field name="DESCRIPTION"   class="java.lang.String"/>

    <variable name="histCount" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{DATE_CREATION}]]></variableExpression>
    </variable>

    <title>
        <band height="145" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="535" height="145" backcolor="#0A1929"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="535" height="4" backcolor="#00BCD4"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>

            <ellipse>
                <reportElement mode="Opaque" x="20" y="25" width="70" height="70" backcolor="#1565C0"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </ellipse>
            <staticText>
                <reportElement x="20" y="25" width="70" height="70" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[E]]></text>
            </staticText>

            <textField>
                <reportElement x="104" y="15" width="425" height="26" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{EMPLOYE_NOM}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="104" y="45" width="55" height="12" forecolor="#64B5F6"/>
                <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Matricule :]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="45" width="100" height="12" forecolor="#00BCD4"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{MATRICULE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="280" y="45" width="60" height="12" forecolor="#64B5F6"/>
                <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Département :]]></text>
            </staticText>
            <textField>
                <reportElement x="345" y="45" width="180" height="12" forecolor="#00BCD4"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{DEPARTEMENT}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="104" y="60" width="55" height="12" forecolor="#64B5F6"/>
                <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Email :]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="60" width="100" height="12" forecolor="#00BCD4"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{EMAIL}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="280" y="60" width="60" height="12" forecolor="#64B5F6"/>
                <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
                <text><![CDATA[Embauche :]]></text>
            </staticText>
            <textField>
                <reportElement x="345" y="60" width="100" height="12" forecolor="#00BCD4"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{DATE_EMBAUCHE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="14" y="125" width="70" height="12" forecolor="#4DD0E1"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <text><![CDATA[Généré le :]]></text>
            </staticText>
            <textField>
                <reportElement x="86" y="125" width="200" height="12" forecolor="#4DD0E1"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{GENERATED_DATE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="44">
            <line>
                <reportElement x="0" y="2" width="535" height="1" forecolor="#BBDEFB"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="6" width="535" height="18" backcolor="#00838F"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="8" y="6" width="400" height="18" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[  ▶  HISTORIQUE RH]]></text>
            </staticText>

            <rectangle>
                <reportElement mode="Opaque" x="0" y="26" width="535" height="16" backcolor="#006064"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="2" y="26" width="70" height="16" forecolor="#E0F7FA"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[DATE]]></text>
            </staticText>
            <staticText>
                <reportElement x="74" y="26" width="90" height="16" forecolor="#E0F7FA"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[TYPE]]></text>
            </staticText>
            <staticText>
                <reportElement x="166" y="26" width="280" height="16" forecolor="#E0F7FA"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[DESCRIPTION]]></text>
            </staticText>
            <staticText>
                <reportElement x="448" y="26" width="85" height="16" forecolor="#E0F7FA"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <text><![CDATA[STATUT]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="535" height="18" backcolor="#E0F7FA">
                    <printWhenExpression><![CDATA[$V{histCount} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <line>
                <reportElement x="0" y="17" width="535" height="1" forecolor="#B2EBF2"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>

            <textField isBlankWhenNull="true">
                <reportElement x="2" y="2" width="70" height="14" forecolor="#37474F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{DATE_CREATION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="74" y="2" width="90" height="14" forecolor="#00695C"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{TYPE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="166" y="2" width="280" height="14" forecolor="#263238"/>
                <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{DESCRIPTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="448" y="2" width="85" height="14" forecolor="#1565C0"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{STATUT}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="16">
            <line>
                <reportElement x="0" y="0" width="535" height="1" forecolor="#1565C0"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="2" width="200" height="12" forecolor="#90A4AE"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <text><![CDATA[GerAI – Fiche Signalétique Employé]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="2" width="196" height="12" forecolor="#90A4AE"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Généré le " + $P{GENERATED_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="2" width="80" height="12" forecolor="#90A4AE"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="50">
            <line>
                <reportElement x="0" y="4" width="535" height="1" forecolor="#1565C0"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </line>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="8" width="535" height="38" backcolor="#0A1929"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="8" width="4" height="38" backcolor="#00BCD4"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="14" width="280" height="12" forecolor="#90CAF9"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <text><![CDATA[Document généré automatiquement par le système GerAI]]></text>
            </staticText>
            <textField>
                <reportElement x="12" y="30" width="280" height="12" forecolor="#64B5F6"/>
                <textElement><font fontName="SansSerif" size="8"/></textElement>
                <textFieldExpression><![CDATA["Date de génération : " + $P{GENERATED_DATE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="30" width="231" height="12" forecolor="#4DD0E1"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="7" isItalic="true"/></textElement>
                <text><![CDATA[© GerAI – Document RH Confidentiel]]></text>
            </staticText>
        </band>
    </summary>

    <noData>
        <band height="60">
            <staticText>
                <reportElement x="0" y="20" width="535" height="20" forecolor="#90A4AE"/>
                <textElement textAlignment="Center"><font fontName="SansSerif" size="12"/></textElement>
                <text><![CDATA[Aucun historique RH disponible pour cet employé.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>