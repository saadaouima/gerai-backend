# ──────────────────────────────────────────────────────────────
#  GerAI Analytics Service — Modèle de Configuration
#  (Copier ce fichier vers .env et remplir les valeurs)
# ──────────────────────────────────────────────────────────────

# 🔌 Serveur
PORT=8086

# 🗄️ Oracle Database
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USER=gerai_user
DB_PASSWORD=votre_mot_de_passe_oracle

# 🔐 Keycloak (Sécurité & Admin)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/gerai
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=gerai
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=votre_mot_de_passe_keycloak

# 📡 Infrastructure (Kafka & Redis)
KAFKA_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# 📁 Chemins & CORS
# Remplacez par vos chemins locaux (utilisez / même sur Windows)
REPORTS_EXPORT_DIR=C:/GerAI/exports/reports
CORS_ALLOWED_ORIGIN=http://localhost:4200

# 🧪 Identifiants de Test (Utilisés dans le README pour obtenir le TOKEN)
TEST_ADMIN_EMAIL=admin_rh@gerai.com
TEST_ADMIN_PASSWORD=votre_password_test
TEST_CHEF_EMAIL=chef@gerai.com
TEST_CHEF_PASSWORD=votre_password_test