# 🔌 SERVER
SERVER_PORT=8084
# SPRING_PROFILES_ACTIVE=dev

# 🗄️ DATABASE (Oracle FREEPDB1)
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USER=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe

# 🔐 KEYCLOAK
# URI du Realm pour la validation des jetons JWT
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/gerai

# 📡 INFRASTRUCTURE
# Adresse du broker Kafka
KAFKA_SERVERS=localhost:9092
# Origine autorisée pour le Frontend
CORS_ALLOWED_ORIGIN=http://localhost:4200

# 📧 EMAIL CONFIGURATION (SMTP - Gmail)
# Note : Utilisez un "Mot de passe d'application" si vous utilisez Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@exemple.com
SMTP_PASS=votre_code_application_16_caracteres