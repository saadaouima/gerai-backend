# ──────────────────────────────────────────────────────────────
#  SYNAPSE DEMANDES SERVICE - TEMPLATE CONFIGURATION (.env.example)
# ──────────────────────────────────────────────────────────────

# 🔌 SERVER
SERVER_PORT=8085
# SPRING_PROFILES_ACTIVE=dev

# 🗄️ DATABASE (Oracle FREEPDB1)
# Remplacer par vos accès locaux si différents
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USER=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe

# 🔐 KEYCLOAK
# L'URI du Realm pour la validation des tokens JWT
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/gerai

# 📡 INFRASTRUCTURE
# Adresse du broker Kafka pour les notifications
KAFKA_SERVERS=localhost:9092
# Origine autorisée pour le Frontend Angular
CORS_ALLOWED_ORIGIN=http://localhost:4200

# 🧪 TEST CREDENTIALS (Utilisés pour la documentation ou tests unitaires)
TEST_ADMIN_EMAIL=admin_rh@gerai.com
TEST_ADMIN_PASSWORD=********
TEST_CHEF_EMAIL=chef@gerai.com
TEST_CHEF_PASSWORD=********