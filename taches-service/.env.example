# ──────────────────────────────────────────────────────────────────
#  SYNAPSE - TACHES-SERVICE : TEMPLATE DES VARIABLES D'ENVIRONNEMENT
#  Copiez ce fichier vers ".env" et remplissez les valeurs réelles.
# ──────────────────────────────────────────────────────────────────

# 🌐 SERVER
SERVER_PORT=8088

# 🗄️ ORACLE DATABASE
# Exemple : jdbc:oracle:thin:@localhost:1521/FREEPDB1 ou /xe
DB_URL=jdbc:oracle:thin:@localhost:1521/VOTRE_SERVICE_NAME
DB_USER=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe

# ✉️ KAFKA (Notifications)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 🔐 SECURITY (Keycloak)
# Remplacez "gerai" par le nom de votre Realm
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/votre_realm

# 📁 STORAGE
# Utilisez des slashs "/" même sur Windows pour éviter les erreurs Java
FILE_UPLOAD_DIR=C:/votre/chemin/uploads/taches