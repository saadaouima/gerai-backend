# ═══════════════════════════════════════════════════════════
#  Synapse — Infrastructure Configuration (Root)
# ═══════════════════════════════════════════════════════════

# --- MailHog Configuration ---
# Interface Web disponible sur http://localhost:8025
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025

# --- Kafka Configuration ---
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# --- SMTP Test Credentials (cohérent avec MailHog) ---
# Ces valeurs sont à reporter dans le .env du Notification Service
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@synapse.com
SMTP_PASS=any

# --- Docker Network Name ---
DOCKER_NETWORK_NAME=synapse-network